# Copy to .env for npm run dev / npm start. Never commit real credentials.
PORT=3978
# Defaults to Microsoft. Set to local only in an ignored development .env.
AUTH_MODE=microsoft
# Optional, local mode only: JSON list replacing the built-in local people.
# TESTHUB_LOCAL_USERS='[{"name":"Nome Apelido","email":"nome@exemplo.test"}]'
# Code asked by the first-run setup (whoever enters it becomes master administrator).
# Leave empty to have the server generate one and print it to its log.
TESTHUB_SETUP_CODE=
# Local Docker PostgreSQL settings. Keep DATABASE_URL in sync when changing them.
POSTGRES_DB=testhub
POSTGRES_USER=testhub
POSTGRES_PASSWORD=replace-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://testhub:replace-me@localhost:5432/testhub?sslmode=disable
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Exactly match the Entra exposed API URI and Teams manifest resource.
ENTRA_RESOURCE_URI=api://localhost:3978/replace-with-client-id
# Server-only secret used for the delegated Graph on-behalf-of flow.
ENTRA_CLIENT_SECRET=
# Teams app id (manifest "id", written by the Toolkit provision). Enables activity feed
# notifications; leave empty to keep notifications only inside the app.
TEAMS_APP_ID=
# For Teams development, use trusted local HTTPS certificates.
SSL_CRT_FILE=
SSL_KEY_FILE=
